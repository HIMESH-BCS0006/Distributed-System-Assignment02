                                    <xsd:element name="bookId" type="xsd:string" minOccurs="0"/>
                                    <xsd:element name="memberId" type="xsd:string" minOccurs="0"/>
                                    <xsd:element name="status" type="xsd:string" minOccurs="0"/>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <!-- SOAP faults -->
            <xsd:element name="InvalidInputFault" type="xsd:string"/>
            <xsd:element name="BookNotFoundFault" type="xsd:string"/>
            <xsd:element name="NoCopiesAvailableFault" type="xsd:string"/>
            <xsd:element name="ServiceUnavailableFault" type="xsd:string"/>
